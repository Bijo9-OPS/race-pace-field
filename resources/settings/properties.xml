<properties>
    <!-- 0 = 5K, 1 = 10K, 2 = Half marathon, 3 = Marathon, 4 = Custom -->
    <property id="raceDistance" type="number">3</property>
    <!-- Only used when raceDistance is 4 (Custom) -->
    <property id="customDistance" type="float">42.195</property>
    <!-- 0 = kilometres, 1 = miles -->
    <property id="customUnit" type="number">0</property>

    <!-- 0 = use the goal finish time, 1 = use the goal pace -->
    <property id="targetMode" type="number">0</property>
    <!-- Goal finish time, written as h:mm:ss (for example 3:30:00 or 0:45:00) -->
    <property id="targetTime" type="string">3:30:00</property>
    <!-- Goal pace, written as m:ss (for example 4:58) -->
    <property id="targetPace" type="string">5:00</property>
    <!-- 0 = goal pace is per km, 1 = goal pace is per mile -->
    <property id="targetPaceUnit" type="number">0</property>

    <!-- Watches usually measure a race a little long. 1.0 here plans for 1% extra distance. -->
    <property id="distanceAdjust" type="float">0.0</property>
</properties>
